&nbsp;'</span><span class="mtk1">.join(pilihan_valid)}</span><span class="mtk21">."</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;3.&nbsp;Menentukan&nbsp;pemenang&nbsp;style&nbsp;berdasarkan&nbsp;skor&nbsp;te</span><span class="mtk8">rtinggi</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;style_dominan&nbsp;=&nbsp;skor_style.most_common(</span><span class="mtk12">1</span><span class="mtk1">)[</span><span class="mtk12">0</span><span class="mtk1">][</span><span class="mtk12">0</span><span class="mtk1">]</span></span><br><span><span></span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk8">#&nbsp;4.&nbsp;Tampilan&nbsp;Hasil&nbsp;Akhir&nbsp;Kuis</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"\n"</span><span class="mtk1">&nbsp;+&nbsp;</span><span class="mtk21">"="</span><span class="mtk1">*</span><span class="mtk12">18</span><span class="mtk1">&nbsp;+&nbsp;</span><span class="mtk21">"&nbsp;FaSHion&nbsp;SHOW&nbsp;RESULTS&nbsp;"</span><span class="mtk1">&nbsp;+&nbsp;</span><span class="mtk21">"="</span><span class="mtk1">*</span><span class="mtk12">18</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk6">f</span><span class="mtk21">"&nbsp;Gaya&nbsp;pakaian&nbsp;yang&nbsp;paling&nbsp;cocok&nbsp;buat&nbsp;kamu&nbsp;adalah:&nbsp;</span><span class="mtk21">‚ú®&nbsp;</span><span class="mtk1">{style_dominan.upper()}</span><span class="mtk21">&nbsp;‚ú®"</span><span class="mtk1">)</span></span><br><span><span class="mtk1">&nbsp;&nbsp;&nbsp;&nbsp;</span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"="</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk1